{
  "name": "mermaid-lite",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "tsc --noEmit",
    "test": "playwright test",
    "build": "npm run check && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "deploy:workers": "npm run build && wrangler deploy --config wrangler.workers.jsonc"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@codemirror/language": "^6.11.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.36.0",
    "@lezer/highlight": "^1.2.1",
    "codemirror": "^6.0.1",
    "mermaid": "12.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "typescript": "~5.9.3",
    "vite": "8.3.8",
    "wrangler": "4.168.0"
  }
}
